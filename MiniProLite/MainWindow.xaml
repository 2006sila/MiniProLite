<Window x:Class="MiniProLite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniProLite" Width="392" Height="264"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Icon="app.ico"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">
    <Grid Margin="18,16,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 状态行 -->
        <TextBlock x:Name="StatusText" Grid.Row="0" Text="读取中…"
                   TextWrapping="Wrap" FontWeight="SemiBold" />

        <!-- 性能模式 -->
        <TextBlock Grid.Row="1" Text="性能模式" Margin="0,16,0,6" Foreground="#666666" />
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button x:Name="SilentButton" Content="静音" Width="110" Height="34" Margin="0,0,8,0"
                    Click="SilentButton_Click" />
            <Button x:Name="BalancedButton" Content="均衡" Width="110" Height="34" Margin="0,0,8,0"
                    Click="BalancedButton_Click" />
            <Button x:Name="PerformanceButton" Content="性能" Width="110" Height="34"
                    Click="PerformanceButton_Click" />
        </StackPanel>

        <!-- 风扇 -->
        <TextBlock Grid.Row="3" Text="风扇" Margin="0,16,0,6" Foreground="#666666" />
        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Button x:Name="FanFullButton" Content="满转 100%" Width="174" Height="34" Margin="0,0,8,0"
                    Click="FanFullButton_Click" />
            <Button x:Name="FanAutoButton" Content="EC 自动" Width="174" Height="34"
                    Click="FanAutoButton_Click" />
        </StackPanel>

        <!-- 底部提示 -->
        <TextBlock Grid.Row="6" Text="点 X 只收进托盘；要彻底退出请用托盘菜单「退出（交回 EC 自动）」"
                   TextWrapping="Wrap" Foreground="#999999" FontSize="11" />
    </Grid>
</Window>
